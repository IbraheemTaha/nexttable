# Copy this file to .env and adjust values for your local setup.
# If no .env file is present at all, the app still runs locally using an
# explicitly-labeled insecure development default for SECRET_KEY (see
# backend/config/settings.py) - so .env is optional for local development,
# but required for anything resembling production.

# Django's cryptographic signing key. Any non-empty string works for local
# development. Generate a real, secret value for any shared/deployed
# environment - never commit a real SECRET_KEY.
SECRET_KEY=dev-example-secret-key-change-me

# "True" or "False". Defaults to True (local development) if unset.
DEBUG=True

# Comma-separated list of hostnames the app is allowed to serve, e.g.
# "example.com,www.example.com". Empty/unset is fine for local development
# with DEBUG=True.
ALLOWED_HOSTS=localhost,127.0.0.1

# Port the Django dev server binds to. `uv run backend/manage.py runserver`
# only respects this via `scripts/dev-backend.sh`; the frontend's Vite proxy
# (frontend/vite.config.ts) also reads it, so change it here rather than in
# either place individually.
BACKEND_PORT=8000

# Origins allowed to talk to the API (the frontend dev server / deployed
# origin). Vite is pinned to 5173 with strictPort (see vite.config.ts), so
# there's only ever one dev origin to trust.
FRONTEND_ORIGINS=http://localhost:5173
